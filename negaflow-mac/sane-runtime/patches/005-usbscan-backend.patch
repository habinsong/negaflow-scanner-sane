+#ifdef _WIN32
+/* Talking to a scanner that keeps the driver it came with — usbscan.sys
+ *
+ * On Windows a USB device is owned by exactly one kernel function driver,
+ * and libusb can only reach devices owned by WinUSB, libusbK or libusb0.
+ * Scanner packages bind the Microsoft still-image class driver instead, so
+ * the scanner enumerates but never opens: LIBUSB_ERROR_NOT_SUPPORTED.
+ *
+ * Rebinding the device to WinUSB is not an answer.  It takes the vendor
+ * driver away, and the vendor's own software with it.
+ *
+ * usbscan.sys does not have to be replaced.  It exposes raw USB to user
+ * mode by design, and that is exactly the surface sanei_usb needs:
+ *
+ *   control transfer  IOCTL_SEND_USB_REQUEST
+ *   bulk in           ReadFile
+ *   bulk out          WriteFile
+ *   endpoint layout   IOCTL_GET_PIPE_CONFIGURATION
+ *   vendor / product  IOCTL_GET_DEVICE_DESCRIPTOR
+ *   timeouts          IOCTL_SET_TIMEOUT
+ *   stall recovery    IOCTL_RESET_PIPE
+ *
+ * So the scanner works with the manufacturer's driver left in place: no
+ * rebinding, no Zadig, no filter driver, no administrator, no reboot.
+ *
+ * usbscan.h ships in the WDK rather than on a compiler's include path, so
+ * the few definitions used here are restated.  They are the published
+ * interface contract, not guesses.
+ */
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <winioctl.h>
+
+#define USBSCAN_FILE_DEVICE	0x8000
+#define USBSCAN_IOCTL_INDEX	0x0800
+#define USBSCAN_MAX_PIPES	8
+
+#define USBSCAN_IOCTL_GET_DEVICE_DESCRIPTOR \
+  CTL_CODE (USBSCAN_FILE_DEVICE, USBSCAN_IOCTL_INDEX + 6, \
+	    METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define USBSCAN_IOCTL_RESET_PIPE \
+  CTL_CODE (USBSCAN_FILE_DEVICE, USBSCAN_IOCTL_INDEX + 7, \
+	    METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define USBSCAN_IOCTL_SEND_USB_REQUEST \
+  CTL_CODE (USBSCAN_FILE_DEVICE, USBSCAN_IOCTL_INDEX + 9, \
+	    METHOD_BUFFERED, FILE_ANY_ACCESS)
+#define USBSCAN_IOCTL_GET_PIPE_CONFIGURATION \
+  CTL_CODE (USBSCAN_FILE_DEVICE, USBSCAN_IOCTL_INDEX + 10, \
+	    METHOD_BUFFERED, FILE_ANY_ACCESS)
+
+/* RAW_PIPE_TYPE, as reported by IOCTL_GET_PIPE_CONFIGURATION */
+#define USBSCAN_PIPE_BULK	2
+#define USBSCAN_PIPE_INTERRUPT	3
+
+/* PIPE_TYPE, the argument of IOCTL_RESET_PIPE */
+#define USBSCAN_READ_DATA_PIPE	1
+#define USBSCAN_WRITE_DATA_PIPE	2
+
+/* how far up \\.\UsbscanN device names are probed */
+#define USBSCAN_MAX_DEVICES	16
+
+typedef struct
+{
+  unsigned int uOffset;
+  unsigned int uLength;
+  unsigned char *pbyData;
+  unsigned int uIndex;
+  unsigned char bRequest;
+  unsigned char bmRequestType;
+  unsigned char fTransferDirectionIn;
+}
+usbscan_io_block_ex;
+
+typedef struct
+{
+  unsigned short MaximumPacketSize;
+  unsigned char EndpointAddress;
+  unsigned char Interval;
+  int PipeType;
+}
+usbscan_pipe_information;
+
+typedef struct
+{
+  unsigned int NumberOfPipes;
+  usbscan_pipe_information PipeInfo[USBSCAN_MAX_PIPES];
+}
+usbscan_pipe_configuration;
+#endif /* _WIN32 */
 
