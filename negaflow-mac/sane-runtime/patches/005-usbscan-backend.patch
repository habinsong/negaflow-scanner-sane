+#ifdef _WIN32
+/** whether a handle refers to an open still-image device */
+static int
+usbscan_is_open (HANDLE handle)
+{
+  return handle != NULL && handle != INVALID_HANDLE_VALUE;
+}
+
+/** how long a transfer may take — see the note below, it is not enforceable
+ *
+ * Neither the driver nor this backend can put a deadline on a transfer.
+ *
+ * IOCTL_SET_TIMEOUT reports success and changes nothing: measured against a
+ * real scanner, IOCTL_GET_TIMEOUT answers ERROR_NOT_SUPPORTED and a transfer
+ * the device never answers still takes the driver's own two minutes.
+ *
+ * Opening the handle for overlapped I/O does not help either, which is worth
+ * writing down because it looks like it should.  usbscan.sys completes
+ * IOCTL_SEND_USB_REQUEST synchronously in the calling thread, so
+ * DeviceIoControl blocks for the full two minutes and never returns
+ * ERROR_IO_PENDING — there is nothing to wait on and nothing to cancel.
+ * Measured: a probe that asked for five seconds took 120,015 ms.
+ *
+ * The remaining lever is CancelSynchronousIo from a second thread, which
+ * would mean a watchdog around every one of the thousands of small transfers
+ * a scan makes.  That is not worth its weight here: the frontend runs as a
+ * child process under the plugin's own watchdog, which is what actually
+ * bounds a wedged scan.
+ *
+ * One more thing to know: after a transfer has timed out, this driver keeps
+ * reporting success while handing back the input structure.  Measured, every
+ * later read returned 0x8E, the wValue that was sent.  Data read after a
+ * timeout cannot be trusted.
+ */
+static int usbscan_timeout_ms = 30 * 1000;
+
+/** a bulk transfer on the data pipes
+ *
+ * usbscan.sys picks the pipe from the direction: ReadFile is the bulk IN
+ * pipe and WriteFile the bulk OUT one.
+ */
+static BOOL
+usbscan_bulk (HANDLE handle, void *buffer, DWORD size, DWORD * transferred,
+	      int reading)
+{
+  return reading
+    ? ReadFile (handle, buffer, size, transferred, NULL)
+    : WriteFile (handle, buffer, size, transferred, NULL);
+}
+
+/** whether the still-image driver already owns this vendor/product
+ *
+ * If it does, libusb cannot open the same hardware, so listing it a second
+ * time would only offer the user a device that is certain to fail.
+ */
+static int
+usbscan_already_found (int vendor, int product)
+{
+  int i;
+
+  for (i = 0; i < device_number; i++)
+    if (devices[i].method == sanei_usb_method_usbscan
+	&& !devices[i].missing
+	&& devices[i].vendor == vendor && devices[i].product == product)
+      return 1;
+  return 0;
+}
+
+/** scan for devices behind the still-image class driver */
+static void
+usbscan_scan_devices (void)
+{
+  int index;
+
+  DBG (4, "%s: Looking for still-image class driver devices\n", __func__);
+
+  for (index = 0; index < USBSCAN_MAX_DEVICES; index++)
+    {
+      char path[32];
+      char devname[32];
+      HANDLE handle;
+      usbscan_pipe_configuration pipes;
+      unsigned short identity[4];
+      DWORD returned = 0;
+      device_list_type device;
+      unsigned int pipe;
+
+      sprintf (path, "\\\\.\\Usbscan%d", index);
+      handle = CreateFileA (path, GENERIC_READ | GENERIC_WRITE,
+			    FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+			    OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL);
+      if (handle == INVALID_HANDLE_VALUE)
+	continue;
+
+      /* This is not the USB device descriptor.  usbscan.sys answers with
+	 four words: vendor, product, bcdDevice and the language id.  */
+      memset (identity, 0, sizeof (identity));
+      memset (&pipes, 0, sizeof (pipes));
+      if (!DeviceIoControl (handle, USBSCAN_IOCTL_GET_DEVICE_DESCRIPTOR,
+			    NULL, 0, identity, sizeof (identity), &returned,
+			    NULL)
+	  || returned < 3 * sizeof (identity[0])
+	  || !DeviceIoControl (handle, USBSCAN_IOCTL_GET_PIPE_CONFIGURATION,
+			       NULL, 0, &pipes, sizeof (pipes), &returned,
+			       NULL))
+	{
+	  DBG (3, "%s: %s does not answer as a still-image device, "
+	       "error %lu\n", __func__, path,
+	       (unsigned long) GetLastError ());
+	  CloseHandle (handle);
+	  continue;
+	}
+      CloseHandle (handle);
+
+      memset (&device, 0, sizeof (device));
+      sprintf (devname, "usbscan:%03d", index);
+      device.devname = strdup (devname);
+      if (!device.devname)
+	return;
+      device.vendor = identity[0];
+      device.product = identity[1];
+      device.usbscan_bcd_device = identity[2];
+      device.method = sanei_usb_method_usbscan;
+      device.usbscan_handle = INVALID_HANDLE_VALUE;
+
+      for (pipe = 0;
+	   pipe < pipes.NumberOfPipes && pipe < USBSCAN_MAX_PIPES; pipe++)
+	{
+	  int address = pipes.PipeInfo[pipe].EndpointAddress;
+
+	  if (pipes.PipeInfo[pipe].PipeType == USBSCAN_PIPE_BULK)
+	    {
+	      if (address & USB_DIR_IN)
+		device.bulk_in_ep = address;
+	      else
+		device.bulk_out_ep = address;
+	    }
+	  else if (pipes.PipeInfo[pipe].PipeType == USBSCAN_PIPE_INTERRUPT)
+	    {
+	      if (address & USB_DIR_IN)
+		device.int_in_ep = address;
+	      else
+		device.int_out_ep = address;
+	    }
+	}
+
+      DBG (4, "%s: found still-image device (0x%04x/0x%04x) at %s\n",
+	   __func__, device.vendor, device.product, devname);
+
+      store_device (device);
+    }
+}
+
+/** control transfer through IOCTL_SEND_USB_REQUEST
+ *
+ * usbscan.sys always builds a vendor request addressed to the device, and
+ * documents bmRequestType as unused, so that is the only shape it can
+ * carry.  It is the shape scanner backends use.
+ *
+ * The driver transfers the *output* buffer, which therefore has to be
+ * writable and exactly uLength long.  A caller's buffer need be neither,
+ * hence the bounce buffer.
+ */
+static SANE_Status
+usbscan_control_msg (SANE_Int dn, SANE_Int rtype, SANE_Int req,
+		     SANE_Int value, SANE_Int index, SANE_Int len,
+		     SANE_Byte * data)
+{
+  usbscan_io_block_ex block;
+  unsigned char *bounce = NULL;
+  DWORD returned = 0;
+  int reading = (rtype & USB_DIR_IN) != 0;
+
+  if ((rtype & (0x03 << 5)) != USB_TYPE_VENDOR
+      || (rtype & USB_RECIP_MASK) != USB_RECIP_DEVICE)
+    {
+      DBG (1, "%s: the still-image driver only carries vendor requests to "
+	   "the device, not request type 0x%02x\n", __func__, rtype);
+      return SANE_STATUS_UNSUPPORTED;
+    }
+  if (len < 0)
+    return SANE_STATUS_INVAL;
+
+  if (len > 0)
+    {
+      bounce = malloc ((size_t) len);
+      if (!bounce)
+	return SANE_STATUS_NO_MEM;
+      if (reading)
+	memset (bounce, 0, (size_t) len);
+      else
+	memcpy (bounce, data, (size_t) len);
+    }
+
+  memset (&block, 0, sizeof (block));
+  block.uOffset = (unsigned int) value;
+  block.uIndex = (unsigned int) index;
+  block.uLength = (unsigned int) len;
+  block.pbyData = bounce;
+  block.bRequest = (unsigned char) req;
+  block.bmRequestType = (unsigned char) rtype;
+  block.fTransferDirectionIn = (unsigned char) (reading ? 1 : 0);
+
+  if (!DeviceIoControl (devices[dn].usbscan_handle,
+			USBSCAN_IOCTL_SEND_USB_REQUEST, &block,
+			sizeof (block), bounce, (DWORD) len, &returned,
+			NULL))
+    {
+      DBG (1, "%s: request 0x%02x failed, error %lu\n", __func__, req,
+	   (unsigned long) GetLastError ());
+      free (bounce);
+      return SANE_STATUS_IO_ERROR;
+    }
+
+  if (reading && len > 0)
+    {
+      memcpy (data, bounce, (size_t) len);
+      if (debug_level > 10)
+	print_buffer (data, len);
+    }
+  free (bounce);
+
+  return SANE_STATUS_GOOD;
+}
