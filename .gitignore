.build/
.swiftpm/
.DS_Store

# CMake 빌드 트리 (windows/ 어댑터)
build/
build-*/
cmake-build-*/
/out/
*.profraw
*.tiff
*.tif
__pycache__/
*.py[cod]

# Local editor / agent state
.omo/
.debug-journal.md
AGENTS.md
CLAUDE.md
DESIGN.md
CODEX.md
.codex/
.claude/

# Archives and temporary files
*.zip
*.tar
*.tar.gz
*.tmp

# Windows 배포물은 빌드 산출물이다 (15 MB). make-payload.sh 가 만든다.
Installer/windows/payload/
Installer/windows/*-setup.exe
# GPL plugin의 macOS 소스 트리 안에서 Windows payload를 조립한다.
negaflow-mac/Installer/windows/payload/
negaflow-mac/Installer/windows/*-setup.exe

# 카탈로그는 install.ps1 이 기기마다 자체 서명으로 만든다. 저장소에 담지 않는다.
negaflow-windows/tools/usbscan-bind/*.cat

# makepkg 작업 흔적. `sane-runtime/` 최상위에 패치 사본이 남으면 다음 사람이
# `patches/` 대신 그것을 복사해 새 패치가 조용히 빠진다 (실제로 011 이 그랬다).
negaflow-mac/sane-runtime/src/
negaflow-mac/sane-runtime/pkg/
negaflow-mac/sane-runtime/*.patch
negaflow-mac/sane-runtime/*.tar.bz2
negaflow-mac/sane-runtime/*.tar.gz
negaflow-mac/sane-runtime/*.pkg.tar.zst

# 빌드 산출물
negaflow-windows/out/

# 만드는 과정에서 남긴 기록이다. 구현 과정, 진행 상태, 결정한 이유, 하드웨어 시험
# 기록 같은 것들이라 공개하지 않는다. 공개하는 문서는 negaflow-mac/docs/ 와
# negaflow-windows/docs/ 에 둔다.
#
# 여기 규칙은 새 파일에만 걸린다. 이미 추적 중인 파일은 git rm --cached 로 따로 빼야
# 한다 (2026-08-30 에 48 개를 그렇게 뺐다).
negaflow-windows/dev-notes/
negaflow-mac/dev-notes/
