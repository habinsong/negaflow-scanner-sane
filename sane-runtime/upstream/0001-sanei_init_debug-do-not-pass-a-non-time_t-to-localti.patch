From 1280e078d8f7ec8f50c382e98f1448dd9b75f3fd Mon Sep 17 00:00:00 2001
From: habin song <habin959@gmail.com>
Date: Thu, 6 Aug 2026 08:59:25 +0900
Subject: [PATCH] sanei_init_debug: do not pass a non-time_t to localtime()

sanei_debug_msg() calls localtime(&tv.tv_sec).  That is correct where
struct timeval carries a time_t, but mingw-w64 declares tv_sec as a
32-bit long while time_t is 64 bits.  localtime() then reads four bytes
of neighbouring stack as part of the timestamp, returns NULL for the
resulting out-of-range value, and the next line dereferences it.

The effect is that *any* SANE_DEBUG_* level crashes the frontend on
Windows, which makes the backends undebuggable there.

Reproduce on Windows (MSYS2/MinGW build):

    SANE_DEBUG_DLL=1 scanimage -L      # segmentation fault

Measured on that build:

    sizeof(tv.tv_sec)=4  sizeof(time_t)=8
    localtime(&tv.tv_sec) = NULL
    localtime(&copy)      = valid

Copy into a real time_t before the call, and do not assume the
conversion succeeds.  No behaviour change where tv_sec is already a
time_t.
---
 sanei/sanei_init_debug.c | 18 ++++++++++++++++--
 1 file changed, 16 insertions(+), 2 deletions(-)

diff --git a/sanei/sanei_init_debug.c b/sanei/sanei_init_debug.c
index 690cc2e..f579eb0 100644
--- a/sanei/sanei_init_debug.c
+++ b/sanei/sanei_init_debug.c
@@ -152,11 +152,25 @@ sanei_debug_msg
 	{
           struct timeval tv;
           struct tm *t;
+          time_t seconds;
 
           gettimeofday (&tv, NULL);
-          t = localtime (&tv.tv_sec);
 
-          fprintf (stderr, "[%02d:%02d:%02d.%06ld] [%s] ", t->tm_hour, t->tm_min, t->tm_sec, tv.tv_usec, be);
+          /* tv_sec is not always a time_t.  On mingw-w64 struct timeval
+             carries a 32-bit long while time_t is 64 bits, so passing its
+             address to localtime() makes it read four bytes of neighbouring
+             stack as part of the timestamp; it then returns NULL and the
+             next line dereferences it.  Any SANE_DEBUG_* level crashed the
+             frontend that way.  Copy into a real time_t instead, and do not
+             assume the conversion succeeds.  */
+          seconds = tv.tv_sec;
+          t = localtime (&seconds);
+
+          if (t)
+            fprintf (stderr, "[%02d:%02d:%02d.%06ld] [%s] ", t->tm_hour,
+                     t->tm_min, t->tm_sec, (long) tv.tv_usec, be);
+          else
+            fprintf (stderr, "[%s] ", be);
           vfprintf (stderr, fmt, ap);
 	}
 
-- 
