; negaflow-usbscan.inf — 스캐너를 Windows 자신의 usbscan.sys 에 붙인다
;
; 왜 필요한가
;   sanei_usb 의 Windows 경로(patch 005)는 still-image 클래스 드라이버 usbscan.sys 가
;   열어주는 raw USB 통로로 장치와 이야기한다. 그 통로가 생기려면 장치가 usbscan 서비스에
;   묶여 있어야 한다.
;
;   Plustek OpticFilm 8100 은 이미 묶여 있다 — SilverFast 가 깔아 둔 INF 가 같은 일을 한다.
;   Epson Perfection V700(VID_04B8&PID_012C)은 벤더 클래스(Class_FF) 장치라 Windows 인박스
;   INF 가 맞물리지 않고, 그래서 아무 드라이버도 붙지 않는다(CM_PROB_FAILED_INSTALL, 코드 28).
;   장치가 열리지 않으니 SANE 은 "스캐너 없음" 이라고만 말한다.
;
; 무엇을 설치하는가
;   **아무 바이너리도 설치하지 않는다.** `Include=sti.inf` / `Needs=STI.USBSection` 으로
;   Windows 가 이미 갖고 있는 usbscan.sys 를 가리킬 뿐이다. Epson 소프트웨어도, 서드파티
;   드라이버도, Zadig/WinUSB 재바인딩도 없다. 벤더 소프트웨어를 밀어내지 않으므로
;   EPSON Scan 이나 VueScan 을 나중에 깔아도 그대로 동작한다.
;
; 되돌리기
;   pnputil /delete-driver <게시된 이름> /uninstall

[Version]
Signature   = "$Windows NT$"
Class       = Image
ClassGUID   = {6bdd1fc6-810f-11d0-bec7-08002be2092f}
Provider    = %Provider%
DriverVer   = 08/14/2026,1.0.0.0

[Manufacturer]
%Epson% = Epson.Models, NTamd64, NTarm64

; 판형·해상도·초점 같은 장치 성질은 SANE 백엔드가 갖는다. 여기서는 통로만 연다.
[Epson.Models.NTamd64]
%V700.DeviceDesc% = Negaflow.UsbScan, USB\VID_04B8&PID_012C
%V750.DeviceDesc% = Negaflow.UsbScan, USB\VID_04B8&PID_012B
%V800.DeviceDesc% = Negaflow.UsbScan, USB\VID_04B8&PID_013A
%V850.DeviceDesc% = Negaflow.UsbScan, USB\VID_04B8&PID_013B

[Epson.Models.NTarm64]
%V700.DeviceDesc% = Negaflow.UsbScan, USB\VID_04B8&PID_012C
%V750.DeviceDesc% = Negaflow.UsbScan, USB\VID_04B8&PID_012B
%V800.DeviceDesc% = Negaflow.UsbScan, USB\VID_04B8&PID_013A
%V850.DeviceDesc% = Negaflow.UsbScan, USB\VID_04B8&PID_013B

[Negaflow.UsbScan]
Include     = sti.inf
Needs       = STI.USBSection
SubClass    = StillImage
DeviceType  = 1
DeviceSubType = 0x0
Capabilities  = 0x00000031

[Negaflow.UsbScan.Services]
Include     = sti.inf
Needs       = STI.USBSection.Services

[Strings]
Provider          = "negaflow-scanner-sane"
Epson             = "Epson"
V700.DeviceDesc   = "Epson Perfection V700 Photo (negaflow)"
V750.DeviceDesc   = "Epson Perfection V750 Pro (negaflow)"
V800.DeviceDesc   = "Epson Perfection V800 Photo (negaflow)"
V850.DeviceDesc   = "Epson Perfection V850 Pro (negaflow)"
